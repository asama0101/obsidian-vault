filters:
  or:
    - file.inFolder("10_Inbox")
    - file.inFolder("20_Diary")
views:
  - type: table
    name: メモ
    order:
      - file.name
      - file.folder
      - file.mtime
    sort:
      - property: file.mtime
        direction: DESC
    limit: 20
    columnSize:
      file.folder: 110
      file.mtime: 150
  - type: table
    name: 最近のメモ
    filters:
      and:
        - file.ctime >= today() - duration("7d")
    order:
      - file.name
      - file.folder
      - file.ctime
    sort:
      - property: file.ctime
        direction: DESC
