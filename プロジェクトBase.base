filters:
  and:
    - type == "project"
views:
  - type: table
    name: プロジェクト一覧
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - priority
      - due
      - context
      - tags
      - goal
    columnSize:
      note.status: 130
      note.priority: 110
