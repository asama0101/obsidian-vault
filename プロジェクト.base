views:
  - type: table
    name: プロジェクト一覧
    filters:
      and:
        - type == "project"
        - status != "2_done"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - due
      - context
    columnSize:
      note.status: 130
  - type: table
    name: プロジェクト：すべて（完了含む）
    filters:
      and:
        - type == "project"
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - due
      - context
    columnSize:
      note.status: 130
  - type: table
    name: 関連タスク
    filters:
      and:
        - type == "task"
        - file.hasLink(this.file)
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - due
      - check
      - context
    summaries:
      file.name: Count
    columnSize:
      note.status: 130
  - type: table
    name: 関連議事録
    filters:
      and:
        - type == "meeting"
        - file.hasLink(this.file)
    order:
      - file.name
      - date
      - context
    summaries:
      file.name: Count
