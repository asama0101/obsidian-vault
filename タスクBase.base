filters:
  and:
    - type == "task"
views:
  - type: table
    name: タスク一覧
    groupBy:
      property: status
      direction: ASC
    order:
      - file.name
      - status
      - priority
      - date
      - due
      - check
      - context
      - tags
      - goal
    columnSize:
      note.status: 130
      note.priority: 110
      note.tags: 133
      note.goal: 166
  - type: table
    name: 期限順
    filters:
      and:
        - status != "3_done"
    order:
      - file.name
      - due
      - priority
      - status
      - context
    sort:
      - property: due
        direction: ASC
    columnSize:
      note.due: 110
      note.priority: 110
  - type: table
    name: 優先度別
    filters:
      and:
        - status != "3_done"
    groupBy:
      property: priority
      direction: ASC
    order:
      - file.name
      - priority
      - due
      - status
      - context
    columnSize:
      note.priority: 110
  - type: table
    name: コンテキスト別
    groupBy:
      property: context
      direction: ASC
    order:
      - file.name
      - context
      - status
      - priority
      - due
    columnSize:
      note.status: 130
      note.priority: 110
  - type: table
    name: チェック日順
    filters:
      and:
        - status != "3_done"
    order:
      - file.name
      - check
      - priority
      - status
      - context
    sort:
      - property: check
        direction: ASC
    columnSize:
      note.check: 110
      note.priority: 110
  - type: table
    name: 期限切れ・本日期限
    filters:
      and:
        - status != "3_done"
        - due <= today()
    order:
      - file.name
      - due
      - priority
      - status
      - context
    sort:
      - property: due
        direction: ASC
    columnSize:
      note.due: 110
      note.priority: 110
  - type: table
    name: 本日チェック
    filters:
      and:
        - status != "3_done"
        - check <= today()
    order:
      - file.name
      - check
      - priority
      - status
      - context
    sort:
      - property: check
        direction: ASC
    columnSize:
      note.check: 110
      note.priority: 110
