views:
  - type: table
    name: 日付降順
    filters:
      and:
        - type == "meeting"
    order:
      - file.name
      - date
      - status
      - context
    sort:
      - property: date
        direction: DESC
    columnSize:
      note.date: 110
  - type: table
    name: コンテキスト別
    filters:
      and:
        - type == "meeting"
    groupBy:
      property: context
      direction: ASC
    order:
      - file.name
      - context
      - date
      - status
    columnSize:
      note.date: 110
