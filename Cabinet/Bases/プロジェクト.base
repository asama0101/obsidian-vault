views:
  - type: table
    name: 進行中
    filters:
      and:
        - type == "project"
        - status == "1_active"
    order:
      - file.name
      - due
      - context
    sort:
      - property: due
        direction: ASC
    columnSize:
      note.due: 110
  - type: table
    name: 関連ノート
    filters:
      and:
        - file.hasLink(this.file)
        - type != "project"
    groupBy:
      property: type
      direction: ASC
    order:
      - file.name
      - type
      - status
      - due
      - date
    summaries:
      file.name: Count
  - type: table
    name: 種別-新設
    filters:
      and:
        - type == "project"
        - file.hasTag("種別/新設")
    order:
      - file.name
      - due
      - context
    sort:
      - property: due
        direction: ASC
    columnSize:
      note.due: 110
  - type: table
    name: 種別-障害
    filters:
      and:
        - type == "project"
        - file.hasTag("種別/障害")
    order:
      - file.name
      - due
      - context
    sort:
      - property: due
        direction: ASC
    columnSize:
      note.due: 110
